{
  "name": "@novel/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:conversation-protocol": "pnpm build && node scripts/conversation-protocol-smoke.mjs",
    "smoke:conversation-command": "pnpm build && node scripts/conversation-command-integration-smoke.mjs",
    "smoke:conversation-host-protocol": "pnpm build && node scripts/conversation-host-protocol-smoke.mjs",
    "smoke:conversation-host-lifecycle": "pnpm build && node scripts/conversation-host-lifecycle-smoke.mjs",
    "smoke:conversation-host-control": "pnpm build && node scripts/conversation-host-control-dispatcher-smoke.mjs",
    "smoke:conversation-host-sqlite": "pnpm build && node scripts/conversation-host-sqlite-integration-smoke.mjs",
    "smoke:conversation-output-publishing": "pnpm build && node scripts/conversation-output-publishing-smoke.mjs",
    "smoke:conversation-output-protocol": "pnpm build && node scripts/conversation-output-protocol-smoke.mjs",
    "smoke:conversation-runtime-bootstrap": "pnpm build && node scripts/conversation-runtime-bootstrap-integration-smoke.mjs",
    "smoke:runtime-execution-protocol": "pnpm build && node scripts/runtime-execution-protocol-smoke.mjs",
    "smoke:runtime-event-sink": "pnpm build && node scripts/runtime-event-sink-smoke.mjs",
    "smoke:runtime-state-machine": "pnpm build && node scripts/runtime-state-machine-smoke.mjs",
    "smoke:runtime-input-router": "pnpm build && node scripts/runtime-input-router-smoke.mjs",
    "smoke:runtime-input-pump": "pnpm build && node scripts/runtime-input-pump-smoke.mjs",
    "smoke:turn-controller": "pnpm build && node scripts/turn-controller-smoke.mjs",
    "smoke:runtime-input-resolver": "pnpm build && node scripts/runtime-input-resolver-smoke.mjs",
    "smoke:runtime-input-outcome": "pnpm build && node scripts/runtime-input-outcome-controller-smoke.mjs",
    "smoke:runtime-user-message": "pnpm build && node scripts/runtime-user-message-input-handler-smoke.mjs",
    "smoke:runtime-replay-planner": "pnpm build && node scripts/runtime-replay-planner-smoke.mjs",
    "smoke:runtime-startup-reconciler": "pnpm build && node scripts/runtime-startup-reconciler-smoke.mjs",
    "smoke:runtime-startup-executor": "pnpm build && node scripts/runtime-startup-executor-smoke.mjs",
    "smoke:runtime-bootstrap-startup": "pnpm build && node scripts/runtime-bootstrap-startup-smoke.mjs",
    "smoke:conversation-runtime": "pnpm build && node scripts/conversation-runtime-smoke.mjs",
    "smoke:local-conversation": "pnpm build && node scripts/local-conversation-integration-smoke.mjs",
    "smoke:local-conversation-host": "pnpm build && node scripts/local-conversation-host-integration-smoke.mjs",
    "smoke:conversation-events": "pnpm build && node scripts/conversation-event-live-smoke.mjs && node scripts/conversation-event-follow-smoke.mjs && node scripts/conversation-event-publishing-smoke.mjs && node scripts/conversation-event-integration-smoke.mjs",
    "smoke:conversation-event-integration": "pnpm build && node scripts/conversation-event-integration-smoke.mjs",
    "smoke:message-projection-integration": "pnpm build && node scripts/message-projection-integration-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  }
}
