{
  "name": "novel-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @novel/core dev",
    "typecheck": "pnpm -r typecheck",
    "gui:minimal": "pnpm --filter @novel/core build && pnpm --filter @novel/ui build && node gui/scripts/build-minimal.mjs && pnpm --filter @novel/gui exec electron dist/minimal/main.cjs",
    "gui:minimal:debug": "set NOVEL_LOG_LEVEL=verbose&& pnpm gui:minimal",
    "gui:minimal:release": "set NOVEL_LOG_LEVEL=info&& pnpm gui:minimal"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
