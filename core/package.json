    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  }
}
