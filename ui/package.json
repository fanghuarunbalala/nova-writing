{
  "name": "@novel/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared/*": "./dist/shared/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "check": "tsc -p tsconfig.json --noEmit && eslint --no-error-on-unmatched-pattern \"src/shared/**/*.{ts,tsx}\" \"src/domains/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" && stylelint \"src/**/*.css\"",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/shared/**/*.{ts,tsx}\" \"src/domains/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@novel/core": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.28.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jsdom": "28.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "vitest": "^4.1.10"
  }
}
