{
  "name": "novel-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter @novel/core build && pnpm --filter @novel/ui build && pnpm --filter @novel/gui build && pnpm --filter @novel/web build && pnpm --filter @novel/cli build",
    "check": "pnpm build && pnpm -r check",
    "dev": "pnpm --filter @novel/cli dev",
    "gui": "pnpm --dir gui start:build",
    "smoke:client-shells": "pnpm --dir gui smoke:desktop-web-shell-parity",
    "validate:gui-web": "node scripts/gui-web-validation.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
