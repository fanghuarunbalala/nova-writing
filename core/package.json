    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:novel-foundation": "pnpm build && pnpm exec tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck scripts/novel-foundation-typecheck.ts && node scripts/novel-foundation-smoke.mjs",
    "smoke:novel-canonical-store": "pnpm build && node scripts/novel-canonical-store-smoke.mjs",
