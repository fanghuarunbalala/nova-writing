# dependencies
node_modules/

# build output
dist/

# TS incremental build info
*.tsbuildinfo

# debug 生成物（ProviderCall jsonl/html，仅仓库根目录；core/src/runtime/debug 是源码）
/debug/

# evals 运行产物（结果 JSON/manifest/基线）与 evalite 静态导出
evals/results/
evals/evalite-export/

# evals 书库夹具：真实书不入仓库（版权）；合成书 ywjs 随仓库提交（PRD evals-书库真实评测 F1）
evals/fixtures/books/*
!evals/fixtures/books/ywjs/

# logs
*.log
npm-debug.log*

# 会话事件运行时生成物（gui 本地跑起来的空转储文件）
gui/conversation-*-events

# editor / OS
.DS_Store
.idea/
.vscode/
novel-events-*
novel-events
.zcode/
