# dependencies
node_modules/

# build output
dist/

# TS incremental build info
*.tsbuildinfo

# debug 生成物（ProviderCall jsonl/html，仅仓库根目录；core/src/runtime/debug 是源码）
/debug/

# evals 运行产物（结果 JSON/manifest/基线）与 evalite 静态导出
evals/results/
evals/evalite-export/

# prose-gate 训练框架（training/）：venv、模型资产（无 LFS 不入库，fetch_model.py 可复现）、数据与产物缓存
training/.venv/
training/models/
training/artifacts/
__pycache__/
*.pyc
.pytest_cache/

# 嵌入模型资产（生产端 stylelib 检索）：不入库，scripts/fetch-stylelib-model.mjs 可复现
clients/desktop/core/resources/models/

# evals 书库夹具：真实书不入仓库（版权）；合成书 ywjs 随仓库提交（PRD evals-书库真实评测 F1）
evals/fixtures/books/*
!evals/fixtures/books/ywjs/

# logs
*.log
npm-debug.log*

# 会话事件运行时生成物（gui 本地跑起来的空转储文件）
clients/desktop/gui/conversation-*-events

# editor / OS
.DS_Store
.idea/
.vscode/
novel-events-*
novel-events
.zcode/

# 闭源案例：真实书提取的开篇幕大纲案例（版权考虑，仅本地使用，不入仓库）
/private/
