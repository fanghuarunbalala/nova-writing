            "story_unit",
            "paragraph",
            "volume",
            "chapter",
          ],
          "type": "string",
        },
        "values": {
          "description": "要更新的实体列表（1-64 项：目标 + 乐观锁版本 + 补丁；value 字段按 kind 取用）",
          "items": {
            "additionalProperties": false,
